# Database
DATABASE_URL=postgresql://user:password@localhost:5432/radio

# Redis
REDIS_URL=redis://localhost:6379/0

# DigitalOcean Spaces
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=incident-audio-builder
SPACES_ACCESS_KEY=YOUR_KEY
SPACES_SECRET_KEY=YOUR_SECRET

# Processing
MAX_TIME_WINDOW_HOURS=6
MAX_CONCURRENT_JOBS=2
